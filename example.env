
DEBUG=false # для логов
MOCK_MODE=false # для мок тестов

BASE_URL=http://127.0.0.1:8000 

# --- Группа DeepSeek (модель для генерации HTML) ---
# Ключ обязателен. Получить: https://platform.deepseek.com/api_keys
DEEPSEEK__API_KEY=
DEEPSEEK__MAX_CONNECTIONS=5
DEEPSEEK__TIMEOUT=120
# Опционально: базовый URL совместимого провайдера (например, https://api.vsegpt.ru/v1)
DEEPSEEK__BASE_URL=
# Опционально: имя модели (по умолчанию deepseek-chat)
DEEPSEEK__MODEL=

# --- Группа Unsplash (поиск изображений) ---
# Access Key обязателен. Получить: https://unsplash.com/developers
UNSPLASH__API_KEY=
UNSPLASH__MAX_CONNECTIONS=5
UNSPLASH__TIMEOUT=20
# Опционально: HTTP-прокси для запросов к Unsplash
UNSPLASH__PROXY=
